# 이 파일을 복사해서 application-local.yml로 저장한 뒤, 본인 로컬 DB 정보로 채워주세요.
# application-local.yml은 .gitignore에 의해 절대 깃에 올라가지 않습니다.
#
# 아래는 MariaDB 기준입니다. 순정 MySQL을 쓰신다면
#   url: jdbc:mysql://localhost:3306/triplanner?useSSL=false&serverTimezone=Asia/Seoul&createDatabaseIfNotExist=true
#   driver-class-name: com.mysql.cj.jdbc.Driver
#   dialect: org.hibernate.dialect.MySQLDialect
# 로 바꿔주세요.
spring:
  datasource:
    url: jdbc:mariadb://127.0.0.1:3307/triplanner
    username: your_db_username
    password: your_db_password
    driver-class-name: org.mariadb.jdbc.Driver

jwt:
  secret: change-this-to-a-long-random-string

naver:
  login:
    client-id: your_naver_login_client_id
    client-secret: your_naver_login_client_secret
  # NAVER API HUB(네이버 클라우드 콘솔 > NAVER API HUB) 앱 키 - 일정 장소 검색(지역 검색)에 사용
  # HUB 앱을 만들 때 '지역 검색' API 를 선택해야 한다 (개발자센터 검색 API 는 HUB 로 이관됨)
  app:
    client-id: your_naver_app_client_id
    client-secret: your_naver_app_client_secret
  map:
    client-id: your_naver_map_client_id
    client-secret: your_naver_map_client_secret

# data.go.kr(공공데이터포털) 발급 키 - 기상청, 에어코리아(한국환경공단) 공용
public-data:
  service-key: your_data_go_kr_service_key
