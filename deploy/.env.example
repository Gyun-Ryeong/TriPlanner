# 배포 서버(EC2)용 설정. 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
# .env 는 깃에 올라가지 않는다. 백엔드와 챗봇 서버가 같이 읽는다.

# ── DB: AWS RDS MySQL ─────────────────────────────────────────────
# 백엔드용 (JDBC 주소)
DB_URL=jdbc:mysql://RDS엔드포인트:3306/triplanner?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=admin
# 챗봇 서버용 (같은 DB, 같은 계정)
DB_HOST=RDS엔드포인트
DB_PORT=3306
DB_NAME=triplanner
DB_USER=admin
# 백엔드·챗봇 공용
DB_PASSWORD=

# ── AI: 학교 LLM 게이트웨이 (Amazon Bedrock) ───────────────────────
# 학교에서 받은 주소·키·모델 이름. OpenAI 호환이 아니면 LLM_CHAT_PATH 를 안내받은 경로로 바꾼다
LLM_BASE_URL=https://게이트웨이주소/v1
LLM_CHAT_PATH=/chat/completions
LLM_API_KEY=
LLM_MODEL=bedrock-haiku
# 게이트웨이가 response_format(JSON 모드)을 지원하면 on
LLM_JSON_MODE=off

# ── 백엔드 ───────────────────────────────────────────────────────
JWT_SECRET=길고_무작위인_문자열로_바꾸기
ADMIN_EMAILS=test
# 화면 주소 (탄력적 IP 또는 도메인). 네이버 로그인을 쓰면 아래 두 줄도 같은 주소로
CORS_ALLOWED_ORIGINS=http://서버주소
FRONTEND_REDIRECT_BASE=http://서버주소
NAVER_LOGIN_REDIRECT_URI=http://서버주소/api/auth/naver/callback
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# NAVER API HUB 앱 (장소 검색)
NAVER_APP_CLIENT_ID=
NAVER_APP_CLIENT_SECRET=
# 네이버 클라우드 Maps (지도·자동차 길찾기). 콘솔에서 '서비스 URL'에 서버 주소를 등록해야 지도가 뜬다
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 공공데이터포털 (기상청·에어코리아·관광공사) — 백엔드·챗봇 같은 키
PUBLIC_DATA_SERVICE_KEY=
TMAP_APP_KEY=

# ── 챗봇 서버 ─────────────────────────────────────────────────────
PUBLIC_DATA_API_KEY=
# NAVER API HUB 앱 (뉴스·지역 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 연합뉴스 재난·사건사고 기사 (행정안전부 재난안전데이터 공유플랫폼 safetydata.go.kr)
# 플랫폼의 인증키 관리에서 이 서버의 탄력적 IP를 등록해야 호출된다 (안 되면 네이버 뉴스만으로 동작)
YONHAP_NEWS_API_KEY=
